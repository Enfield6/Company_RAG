# Application
APP_NAME=Company Knowledge AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# MySQL
MYSQL_DATABASE=company_rag
MYSQL_USER=company_rag
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DSN=mysql+asyncmy://company_rag:change-me@mysql:3306/company_rag?charset=utf8mb4

# Milvus
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=company_knowledge_chunks

# Alibaba Cloud Model Studio (China region, OpenAI-compatible endpoint)
QWEN_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# Answer generation and document image understanding share the multimodal Qwen model.
LLM_MODEL=qwen3.5-omni-plus
LLM_TEMPERATURE=0.1
VISION_MODEL=qwen3.5-omni-plus
IMAGE_ENRICHMENT_CONCURRENCY=4

# Optional per-capability overrides. Leave empty to inherit the DashScope URL/key above.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
VISION_BASE_URL=
VISION_API_KEY=

# Files and ingestion
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_MB=100
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.4
